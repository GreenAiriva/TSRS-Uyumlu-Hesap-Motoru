input_cloud/
output_cloud/

# Mevcut TUREKS ve diğer şirket klasörleri (ana dizinde olsa bile)
TUREKS/
01_Kunye/
02_Finansal_Raporlar/
03_Surdurulebilirlik_Verileri/
04_Data_Setler/
05_Uretilen_Rapor_Bolumleri/

